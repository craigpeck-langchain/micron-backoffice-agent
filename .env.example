LANGSMITH_PROJECT="micron-backoffice-agent"
LANGSMITH_TRACING="true"

# LANGSMITH_WORKSPACE_ID=""
LANGSMITH_API_KEY=""
BASE_URL="https://gateway.smith.langchain.com/openai/v1"

# Gateway-scoped service key (lsv2_sk_...) used to authenticate to BASE_URL.
# Required only when BASE_URL is set; leave BASE_URL blank to call OpenAI
# directly with OPENAI_API_KEY instead.
# LC_GATEWAY_KEY=""

# OPENAI_API_KEY=""

# Optional override; defaults to gpt-4o-mini for the top-level classifier and
# the deep agent's default model
BACKOFFICE_MODEL="gpt-4o-mini"

# Only needed for scripts/populate_traces.py --mode remote
LANGGRAPH_DEPLOYMENT_URL=""
